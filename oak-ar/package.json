{
  "name": "oak-ar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:claude-preview": "VITE_MODEL_SUFFIX=.b64.json vite build --outDir dist-preview && node tools/preview-models.mjs dist-preview/models",
    "models": "python3 tools/make_dishes.py public/models",
    "optimize": "node tools/optimize-model.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.0.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.1.1",
    "@gltf-transform/extensions": "4.1.1",
    "@gltf-transform/functions": "4.1.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "meshoptimizer": "0.22.0",
    "sharp": "^0.33.5",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
