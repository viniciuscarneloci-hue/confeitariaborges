---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Demo from '../components/Demo.astro';
import Kit from '../components/Kit.astro';
import Sites from '../components/Sites.astro';
import Orders from '../components/Orders.astro';
import Plaque from '../components/Plaque.astro';
import Steps from '../components/Steps.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Previa · Veja antes de pedir</title>
  <meta name="description" content="Cardápio em 3D e realidade aumentada, site, sistema de pedidos e plaquinhas NFC e QR code para restaurantes." />
  <meta name="theme-color" content="#F4F5F2" />
  <link rel="icon" href="favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;800&family=Geist+Mono:wght@500&family=Instrument+Serif:ital@1&family=Sora:wght@200;300;400&display=swap" />
</head>
<body>
  <Header />
  <main>
    <Hero />
    <Demo />
    <Kit />
    <Sites />
    <Orders />
    <Plaque />
    <Steps />
    <Contact />
  </main>
  <Footer />
</body>
</html>
