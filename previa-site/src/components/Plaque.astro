---
---
<section class="section plaque-sec" id="plaquinha" data-plaque>
  <div class="wrap layout">
    <div class="section-head">
      <h2 class="t-title">Uma plaquinha na mesa, três caminhos no celular.</h2>
      <p class="t-sub">Entregamos uma plaquinha por mesa, com NFC e QR code e a identidade do restaurante. O cliente encosta o celular ou aponta a câmera e escolhe:</p>
      <ul class="routes">
        <li><b>Cardápio em RA</b><span>vê os pratos na mesa e pede</span></li>
        <li><b>Instagram</b><span>segue a casa ali mesmo</span></li>
        <li><b>Avaliar no Google</b><span>deixa a nota no Google Meu Negócio</span></li>
      </ul>
      <button type="button" class="btn btn-ghost" data-tap>Encostar o celular</button>
    </div>

    <div class="scene" data-scene>
      <div class="stand" aria-hidden="true">
        <div class="acrylic">
          <span class="name">Casa Fiore</span>
          <canvas data-qr width="120" height="120"></canvas>
          <span class="nfc"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M7 8a6 6 0 0 1 0 8M10.5 5.5a10 10 0 0 1 0 13M14 3a14 14 0 0 1 0 18" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>Aproxime o celular ou aponte a câmera</span>
          <span class="mesa t-data">Mesa 7</span>
        </div>
        <div class="foot"></div>
      </div>

      <div class="phone" data-phone aria-live="polite">
        <div class="screen">
          <div class="idle"><span class="pulse"></span><p>Aproxime da plaquinha</p></div>
          <div class="menu">
            <p class="m-name">Casa Fiore</p>
            <p class="m-sub">Mesa 7</p>
            <span class="m-opt primary">Ver o cardápio em RA</span>
            <span class="m-opt">Seguir no Instagram</span>
            <span class="m-opt">Avaliar no Google</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .layout .section-head { margin-bottom: 0; justify-items: start; }
  .routes { list-style: none; margin: 4px 0 8px; padding: 0; border-top: 1px solid var(--fio); width: 100%; }
  .routes li { display: grid; grid-template-columns: 10em 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--fio); }
  .routes b { font-weight: 500; }
  .routes span { color: var(--pedra); }

  .scene { position: relative; aspect-ratio: 6 / 5; border-radius: 36px; background: var(--salvia); overflow: hidden; }
  .stand { position: absolute; left: 14%; bottom: 12%; width: 40%; }
  .acrylic { position: relative; display: grid; justify-items: center; gap: 14px; padding: 16% 10% 12%; aspect-ratio: 3 / 4; background: #FBF7F1; color: #5A1A1A; border-radius: 14px 14px 4px 4px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .7), 0 30px 40px -24px rgba(20, 26, 22, .55); }
  .name { font-family: "Instrument Serif", Georgia, serif; font-style: italic; font-size: clamp(20px, 2.6vw, 32px); }
  .acrylic canvas { width: 58% !important; height: auto !important; aspect-ratio: 1; }
  .nfc { display: flex; align-items: center; gap: 6px; font-size: clamp(9px, .9vw, 12px); text-align: center; }
  .mesa { position: absolute; top: 12px; right: 14px; font-size: 10.5px; opacity: .7; }
  .foot { height: 14px; margin: 0 -6%; background: #C9CDC8; border-radius: 3px; box-shadow: 0 18px 24px -14px rgba(20, 26, 22, .5); }

  .phone { position: absolute; right: 9%; top: 10%; width: 30%; aspect-ratio: 9 / 19; background: var(--tinta); border-radius: 13% / 6%; padding: 3%;
    box-shadow: 0 40px 50px -28px rgba(20, 26, 22, .6); transform: rotate(6deg); transition: transform .56s var(--ease); }
  .screen { position: relative; height: 100%; border-radius: 10% / 4.6%; background: var(--porcelana); overflow: hidden; }
  .idle, .menu { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: 12px; padding: 12%; text-align: center; transition: opacity .3s var(--ease); }
  .idle p { font-size: clamp(10px, 1vw, 13px); color: var(--pedra); }
  .pulse { width: 30%; aspect-ratio: 1; border-radius: 50%; border: 2px solid var(--halo); }
  .menu { opacity: 0; background: #FBF7F1; color: #5A1A1A; gap: 8px; align-content: center; }
  .m-name { font-family: "Instrument Serif", Georgia, serif; font-style: italic; font-size: clamp(16px, 1.8vw, 24px); }
  .m-sub { font-size: clamp(9px, .9vw, 12px); opacity: .7; margin-bottom: 8px; }
  .m-opt { width: 100%; padding: 9% 0; border-radius: 999px; border: 1px solid #E2D3C3; font-size: clamp(8.5px, .85vw, 12px); }
  .m-opt.primary { background: #5A1A1A; color: #FBF7F1; border-color: #5A1A1A; }

  .scene.is-tapped .phone { transform: translate(-62%, 18%) rotate(-4deg); }
  .scene.is-tapped .idle { opacity: 0; }
  .scene.is-tapped .menu { opacity: 1; transition-delay: .3s; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .scene { aspect-ratio: 4 / 4.2; }
    .stand { width: 46%; left: 8%; }
    .phone { width: 36%; right: 7%; }
    .routes li { grid-template-columns: 1fr; gap: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .phone, .idle, .menu { transition: none !important; } }
</style>

<script>
  import QR from 'qrcode';
  const root = document.querySelector<HTMLElement>('[data-plaque]')!;
  const scene = root.querySelector<HTMLElement>('[data-scene]')!;
  const btn = root.querySelector<HTMLButtonElement>('[data-tap]')!;
  btn.addEventListener('click', () => {
    const on = scene.classList.toggle('is-tapped');
    btn.textContent = on ? 'Afastar o celular' : 'Encostar o celular';
  });
  const url = new URL(location.href); url.hash = 'demo'; url.search = '';
  QR.toCanvas(root.querySelector<HTMLCanvasElement>('[data-qr]')!, url.toString(), { width: 240, margin: 0, color: { dark: '#5A1A1A', light: '#FBF7F1' } });
</script>
