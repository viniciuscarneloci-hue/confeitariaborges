---
import Symbol from './Symbol.astro';
---
<section class="contact" id="contato" data-contact>
  <div class="wrap layout">
    <div class="copy">
      <h2 class="t-title">Quer ver o seu cardápio na mesa?</h2>
      <p>Conte qual é o restaurante. Respondemos pelo WhatsApp com uma proposta e um prato seu em 3D para testar.</p>
    </div>
    <form data-form novalidate>
      <label><span>Seu nome</span><input name="nome" autocomplete="name" required /></label>
      <label><span>Restaurante</span><input name="restaurante" autocomplete="organization" required /></label>
      <label><span>Cidade</span><input name="cidade" autocomplete="address-level2" required /></label>
      <p class="err" data-err hidden role="alert">Preencha nome, restaurante e cidade para continuar.</p>
      <button class="btn btn-light" type="submit">Continuar no WhatsApp</button>
    </form>
  </div>
  <div class="mark" aria-hidden="true"><Symbol size={560} core="rgba(169, 227, 207, .35)" /></div>
</section>

<style>
  .contact { position: relative; overflow: hidden; background: var(--louro); color: var(--porcelana); padding-block: clamp(88px, 12vw, 160px); }
  .layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: end; }
  .copy { display: grid; gap: 20px; }
  .copy p { color: rgba(244, 245, 242, .78); max-width: 30em; font-size: 18px; }
  form { display: grid; gap: 14px; }
  label { display: grid; gap: 6px; font-size: 14px; color: rgba(244, 245, 242, .78); }
  input { font: inherit; font-size: 17px; color: var(--porcelana); background: transparent; border: 0; border-bottom: 1px solid rgba(244, 245, 242, .4); padding: 10px 0; border-radius: 0; }
  input:focus { outline: none; border-bottom-color: var(--halo); }
  input:focus-visible { box-shadow: 0 2px 0 var(--halo); }
  .err { color: var(--halo); font-size: 14px; }
  form .btn { justify-self: start; margin-top: 12px; }
  .mark { position: absolute; right: -140px; bottom: -200px; color: rgba(244, 245, 242, .07); width: 560px; height: 560px; pointer-events: none; }
  .mark :global(svg) { width: 100%; height: 100%; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } .mark { width: 380px; height: 380px; right: -120px; bottom: -140px; } }
</style>

<script>
  /* Canal de contato: defina o número em PUBLIC_WHATSAPP (só dígitos, com DDI). Sem número,
     o WhatsApp abre com a mensagem pronta e a pessoa escolhe o contato. */
  const NUMBER = (import.meta.env.PUBLIC_WHATSAPP ?? '').replace(/\D/g, '');
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const err = form.querySelector<HTMLElement>('[data-err]')!;
  form.addEventListener('submit', e => {
    e.preventDefault();
    const f = new FormData(form);
    const [nome, rest, cidade] = ['nome', 'restaurante', 'cidade'].map(k => String(f.get(k) ?? '').trim());
    if (!nome || !rest || !cidade) {
      err.hidden = false;
      form.querySelector<HTMLInputElement>(`input[name="${!nome ? 'nome' : !rest ? 'restaurante' : 'cidade'}"]`)!.focus();
      return;
    }
    err.hidden = true;
    const msg = `Olá! Sou ${nome}, do ${rest} (${cidade}). Quero ver o cardápio do meu restaurante em RA com a Previa.`;
    window.open(`https://wa.me/${NUMBER}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });
</script>
