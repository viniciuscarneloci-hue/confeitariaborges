---
import Symbol from './Symbol.astro';
const themes = [
  { id: 'fiore', label: 'Casa Fiore', name: 'Casa Fiore', tag: 'Massa fresca feita todas as manhãs desde 1998.', photo: 'site-fiore', menu: [['Spaghetti al pomodoro', 'R$ 64'], ['Tagliatelle al ragù', 'R$ 72'], ['Tiramisù da casa', 'R$ 34']] },
  { id: 'forno', label: 'FORNO 9', name: 'FORNO 9', tag: 'Pizza napolitana, fermentação de 48 horas.', photo: 'site-forno', menu: [['Diavola', 'R$ 74'], ['Margherita', 'R$ 68'], ['Marinara', 'R$ 52']] },
  { id: 'brasa', label: 'BRASA 22', name: 'BRASA 22', tag: 'Carne na brasa, pão da casa e fogo aceso até tarde.', photo: 'site-brasa', menu: [['Hambúrguer artesanal', 'R$ 49'], ['Ancho na brasa', 'R$ 128'], ['Pudim de doce de leite', 'R$ 26']] },
];
---
<section class="section sites" id="sites" data-sites>
  <div class="wrap">
    <div class="head">
      <div class="section-head">
        <h2 class="t-title">O site leva a marca do restaurante. A Previa só assina.</h2>
        <p class="t-sub">Fazemos o site de cada casa com o logo, as cores e as fontes dela. Troque de restaurante para ver.</p>
      </div>
      <div class="switch" role="radiogroup" aria-label="Restaurante de exemplo">
        {themes.map((t, i) => <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-theme-btn={t.id}>{t.label}</button>)}
      </div>
    </div>

    <div class="browser" data-theme="fiore" data-browser>
      <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span class="url" data-url>casafiore.com.br</span></div>
      <div class="views">
        {themes.map((t, i) => (
          <article class={`view v-${t.id}`} data-view={t.id} aria-hidden={i !== 0 ? 'true' : 'false'}>
            <header class="v-top"><span class="v-name">{t.name}</span><nav><span>Cardápio</span><span>Reservas</span><span>Como chegar</span></nav></header>
            <div class="v-hero">
              <div class="v-copy">
                <p class="v-tag">{t.tag}</p>
                <span class="v-btn">Ver o cardápio na mesa</span>
              </div>
              <div class="v-photo"><img src={`img/${t.photo}.webp`} alt="" loading="lazy" /></div>
            </div>
            <ul class="v-menu">{t.menu.map(([n, p]) => <li><span>{n}</span><span>{p}</span></li>)}</ul>
            <footer class="v-foot"><Symbol size={12} /> powered by previa</footer>
          </article>
        ))}
      </div>
    </div>
    <p class="fine">Restaurantes fictícios, para ilustração.</p>
  </div>
</section>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; margin-bottom: clamp(40px, 6vw, 72px); }
  .head .section-head { margin-bottom: 0; }
  .switch { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--mesa); }
  .switch button { border: 0; background: none; min-height: 42px; padding: 0 18px; border-radius: 999px; cursor: pointer; font-size: 15px; color: var(--pedra); transition: background-color .25s, color .25s; }
  .switch [aria-checked="true"] { background: var(--porcelana); color: var(--tinta); box-shadow: 0 1px 2px rgba(20, 26, 22, .12); }

  .browser { border-radius: 20px; overflow: hidden; background: #fff; box-shadow: 0 1px 0 var(--fio), 0 40px 80px -48px rgba(20, 26, 22, .45); }
  .chrome { display: flex; align-items: center; gap: 7px; padding: 14px 18px; background: #E9EBE7; }
  .chrome i { width: 11px; height: 11px; border-radius: 50%; background: #CDD2CC; }
  .url { margin-left: 16px; padding: 4px 14px; border-radius: 8px; background: var(--porcelana); font-size: 13px; color: var(--pedra); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .views { display: grid; }
  .view { grid-area: 1 / 1; display: grid; gap: clamp(20px, 3vw, 36px); padding: clamp(20px, 4vw, 48px); background: var(--bg); color: var(--ink);
    opacity: 1; transition: opacity .45s var(--ease); }
  .view[aria-hidden="true"] { opacity: 0; visibility: hidden; transition: opacity .45s var(--ease), visibility 0s .45s; }
  .v-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .v-top nav { display: flex; gap: 22px; font-size: 14px; opacity: .75; }
  .v-name { font-family: var(--name-font); font-size: var(--name-size); font-style: var(--name-style, normal); font-weight: var(--name-weight, 400); letter-spacing: var(--name-track, 0); line-height: 1; }
  .v-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 24px; }
  .v-tag { font-family: var(--tag-font, var(--f-body)); font-size: clamp(1.4rem, 3vw, 2.4rem); line-height: 1.15; letter-spacing: -.01em; max-width: 14em; font-style: var(--tag-style, normal); font-weight: var(--tag-weight, 400); }
  .v-copy { display: grid; gap: 24px; justify-items: start; }
  .v-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; background: var(--accent); color: var(--on-accent); border-radius: var(--radius); font-size: 14.5px; font-weight: 500; }
  .v-photo { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--photo-radius, 0); }
  .v-photo img { width: 100%; height: 100%; object-fit: cover; }
  .v-menu { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .v-menu li { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--rule); font-variant-numeric: tabular-nums; }
  .v-foot { display: flex; align-items: center; gap: 6px; font-size: 12px; opacity: .6; }

  .v-fiore { --bg: #FBF7F1; --ink: #5A1A1A; --accent: #5A1A1A; --on-accent: #FBF7F1; --rule: #E9DDD0; --radius: 999px;
    --photo-radius: 200px 200px 8px 8px; --name-font: "Instrument Serif", Georgia, serif; --name-style: italic; --name-size: 30px; --tag-font: "Instrument Serif", Georgia, serif; --tag-style: italic; }
  .v-forno { --bg: #FFFFFF; --ink: #141414; --accent: #141414; --on-accent: #fff; --rule: #141414; --radius: 0;
    --name-font: var(--f-mono); --name-size: 20px; --name-track: .5em; --tag-weight: 300; --photo-radius: 0; }
  .v-brasa { --bg: #1E1712; --ink: #F3E6D6; --accent: #E07A3A; --on-accent: #1E1712; --rule: #3A2D24; --radius: 6px;
    --name-font: var(--f-body); --name-weight: 800; --name-size: 26px; --name-track: -.03em; --tag-weight: 700; --photo-radius: 6px; }

  .fine { margin-top: 16px; font-size: 13px; color: var(--pedra); }
  @media (max-width: 760px) {
    .v-hero { grid-template-columns: 1fr; }
    .v-photo { grid-row: 1; }
    .v-top nav { display: none; }
    .switch button { padding: 0 12px; font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .view, .view[aria-hidden="true"] { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-sites]')!;
  const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-theme-btn]')];
  const urls: Record<string, string> = { fiore: 'casafiore.com.br', forno: 'forno9.com.br', brasa: 'brasa22.com.br' };
  const pick = (id: string) => {
    btns.forEach(b => { const on = b.dataset.themeBtn === id; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
    root.querySelectorAll<HTMLElement>('[data-view]').forEach(v => v.setAttribute('aria-hidden', String(v.dataset.view !== id)));
    root.querySelector('[data-url]')!.textContent = urls[id];
  };
  btns.forEach((b, i) => {
    b.addEventListener('click', () => pick(b.dataset.themeBtn!));
    b.addEventListener('keydown', e => {
      const n = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (n) { e.preventDefault(); const t = btns[(i + n + btns.length) % btns.length]; t.focus(); pick(t.dataset.themeBtn!); }
    });
  });
  btns.forEach((b, i) => { if (i) b.tabIndex = -1; });
</script>
