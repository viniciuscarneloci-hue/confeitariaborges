---
import { SYMBOL } from '../scripts/symbol';
---
<section class="hero" id="topo" data-hero aria-label="Previa">
  <div class="stage">
    <div class="wrap grid">
      <div class="scene" aria-hidden="true">
        <svg class="rings" viewBox="0 0 64 64" data-rings>
          <path data-outer d={SYMBOL.outer} fill="var(--tinta)" fill-rule="evenodd" />
          <path data-inner d={SYMBOL.inner} fill="var(--tinta)" fill-rule="evenodd" />
          <path data-core d={SYMBOL.core} fill="var(--latao)" fill-rule="evenodd" />
        </svg>
        <div class="halo" data-halo></div>
        <model-viewer data-hero-mv class="mv" alt="Pizza margherita em 3D sobre a mesa"
          camera-orbit="0deg 0deg 150%" min-camera-orbit="auto 0deg auto" field-of-view="28deg"
          interaction-prompt="none" disable-zoom disable-pan shadow-intensity="0.9" shadow-softness="0.8"
          exposure="1.05" environment-image="neutral" loading="eager" reveal="auto"></model-viewer>
      </div>

      <div class="copy">
        <div class="copy-a" data-copy-a>
          <h1 class="t-display">Veja antes<br />de pedir.</h1>
          <p class="t-sub">Cardápio em realidade aumentada, site e pedidos para restaurantes. A sua marca na frente, a Previa nos bastidores.</p>
          <p class="hint" aria-hidden="true"><span></span>Role para pôr o prato na mesa</p>
        </div>
        <div class="copy-b" data-copy-b>
          <h2 class="t-title">O prato aparece na mesa do cliente, em tamanho real.</h2>
          <p class="t-sub">Ele aponta o celular, vê a porção e a montagem do chef e pede sabendo o que vai chegar.</p>
          <div class="actions">
            <a class="btn btn-primary" href="#demo"><span class="dot"></span>Ver um prato na minha mesa</a>
            <a class="btn btn-ghost" href="#contato">Falar com a Previa</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 320svh; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; display: flex; align-items: center; }
  .grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); align-items: center; gap: clamp(24px, 4vw, 64px); padding-top: 72px; }
  .copy { grid-column: 1; grid-row: 1; display: grid; }
  .copy-a, .copy-b { grid-area: 1 / 1; display: grid; gap: 24px; align-content: center; will-change: opacity, transform; }
  .copy-b { opacity: 0; visibility: hidden; }
  .copy-a .t-display { margin-left: -.05em; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .hint { display: flex; align-items: center; gap: 12px; margin-top: 28px; font-size: 14px; color: var(--pedra); }
  .hint span { width: 36px; height: 1px; background: currentColor; }

  .scene { grid-column: 2; grid-row: 1; position: relative; aspect-ratio: 1; width: min(100%, 76svh); justify-self: center; }
  .rings { position: absolute; inset: 6%; width: 88%; height: 88%; will-change: transform, opacity; }
  .mv { position: absolute; inset: -8%; width: 116%; height: 116%; opacity: 0; --poster-color: transparent; background: transparent; }
  .halo { position: absolute; left: 50%; bottom: 17%; width: 84%; aspect-ratio: 3 / 1; translate: -50% 0; border-radius: 50%;
    border: 2px solid var(--halo); opacity: 0; scale: .2; box-shadow: 0 0 0 10px rgba(169, 227, 207, .18); pointer-events: none; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; grid-template-rows: auto auto; gap: 8px; padding-top: 64px; align-content: center; }
    .scene { grid-column: 1; grid-row: 1; width: min(100%, 44svh); }
    .copy { grid-row: 2; }
    .copy-a, .copy-b { gap: 16px; }
    .t-display { font-size: clamp(2.8rem, 13vw, 4.4rem); }
    .hint { margin-top: 8px; }
  }

  /* Movimento reduzido: só o quadro final, sem rolagem presa */
  .hero.is-static { height: auto; }
  .hero.is-static .stage { position: relative; height: auto; min-height: 100svh; padding-block: 120px 64px; }
  .hero.is-static .copy-a, .hero.is-static .copy-b { grid-area: auto; opacity: 1; visibility: visible; transform: none; }
  .hero.is-static .copy { gap: 48px; }
  .hero.is-static .hint, .hero.is-static .rings { display: none; }
  .hero.is-static .mv, .hero.is-static .halo { opacity: 1; scale: 1; }
</style>

<script>
  import { ring } from '../scripts/symbol';
  import { loadViewer, modelSrc, reducedMotion } from '../scripts/models';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const rings = hero.querySelector<SVGElement>('[data-rings]')!;
  const outer = hero.querySelector('[data-outer]')!;
  const inner = hero.querySelector('[data-inner]')!;
  const core = hero.querySelector('[data-core]')!;
  const halo = hero.querySelector<HTMLElement>('[data-halo]')!;
  const mv = hero.querySelector<any>('[data-hero-mv]')!;
  const a = hero.querySelector<HTMLElement>('[data-copy-a]')!;
  const b = hero.querySelector<HTMLElement>('[data-copy-b]')!;

  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const seg = (p: number, s: number, e: number) => clamp((p - s) / (e - s));
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const lerp = (x: number, y: number, t: number) => x + (y - x) * t;

  loadViewer().then(() => modelSrc('pizza-margherita')).then(src => { mv.src = src; });

  let last = -1;
  function frame() {
    const r = hero.getBoundingClientRect();
    const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
    if (p === last) return; last = p;

    // 1. Prato visto de cima → os aros descem e o ponto pousa (o movimento do logo)
    const k1 = ease(seg(p, 0.02, 0.3));
    outer.setAttribute('d', ring(32, 27, lerp(2.6, 2.2, k1), lerp(2.6, 3.8, k1)));
    inner.setAttribute('d', ring(lerp(32, 37, k1), 17, lerp(2, 1.7, k1), lerp(2, 3.1, k1)));
    const t = lerp(1.6, 7, ease(seg(p, 0.16, 0.3)));
    core.setAttribute('d', ring(lerp(32, 42, k1), 7, t, t));

    // 2. Os aros saem, o prato de verdade entra e a câmera inclina
    const k2 = ease(seg(p, 0.32, 0.7));
    rings.style.opacity = String(1 - k2);
    rings.style.transform = `translateY(${k2 * 6}%) scale(${1 + k2 * 0.12}, ${1 - k2 * 0.5})`;
    mv.style.opacity = String(seg(p, 0.3, 0.5));
    mv.cameraOrbit = `${lerp(0, -18, k2)}deg ${lerp(0, 62, k2)}deg ${lerp(150, 165, k2)}%`;
    mv.jumpCameraToGoal?.();

    // 3. O ponto vira o anel Halo do AR, sob o prato
    const k3 = ease(seg(p, 0.55, 0.8));
    halo.style.opacity = String(k3);
    halo.style.scale = String(lerp(0.2, 1, k3));

    const k4 = ease(seg(p, 0.6, 0.85));
    a.style.opacity = String(1 - seg(p, 0.5, 0.66));
    a.style.transform = `translateY(${-k4 * 24}px)`;
    a.style.visibility = k4 >= 1 ? 'hidden' : 'visible';
    b.style.opacity = String(k4);
    b.style.transform = `translateY(${(1 - k4) * 24}px)`;
    b.style.visibility = k4 > 0 ? 'visible' : 'hidden';
  }

  if (reducedMotion()) {
    hero.classList.add('is-static');
    mv.cameraOrbit = '-18deg 62deg 165%';
  } else {
    let raf = 0;
    const tick = () => { raf = 0; frame(); };
    addEventListener('scroll', () => { raf ||= requestAnimationFrame(tick); }, { passive: true });
    addEventListener('resize', () => { last = -1; frame(); });
    mv.addEventListener('load', () => { last = -1; frame(); });
    frame();
  }
</script>
